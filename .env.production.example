# =============================================================================
# CREA (IYEM) - Plantilla de variables para PRODUCCIÓN
# =============================================================================
# - Este archivo NO lleva valores reales. Los textos tipo ..._AQUI se
#   reemplazan en el servidor.
# - Copiar como .env.production (ya está en .gitignore), llenar los valores y
#   subirlo al servidor como .env (ver pasos en deploy.sh).
# - Se omiten a propósito las variables que CREA no usa: REDIS_*, MEMCACHED_*,
#   AWS_*, BROADCAST_CONNECTION y PHP_CLI_SERVER_WORKERS.
# =============================================================================

# --- Aplicación --------------------------------------------------------------

# Nombre de la aplicación. También define el nombre de la cookie de sesión.
APP_NAME=CREA

# Entorno. En producción SIEMPRE "production".
APP_ENV=production

# Clave de cifrado. Dejar vacía aquí; se genera una sola vez en el servidor
# (php artisan key:generate --force). Nunca guardarla en el repositorio.
APP_KEY=

# Depuración. En producción SIEMPRE "false": con "true" un error muestra rutas,
# variables y consultas a cualquier persona.
APP_DEBUG=false

# URL pública con https. Se usa para enlaces de correo y para el redirect de
# Google (GOOGLE_REDIRECT_URI).
APP_URL=https://crea.iyemyucatan.com

# Idioma de la aplicación y de respaldo.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Dónde se guarda el estado de "modo mantenimiento".
APP_MAINTENANCE_DRIVER=file

# Costo del cifrado de contraseñas (12 es el valor recomendado).
BCRYPT_ROUNDS=12

# --- Logs --------------------------------------------------------------------

# Canal principal de logs ("stack" agrupa los canales de LOG_STACK).
LOG_CHANNEL=stack

# Canal(es) del stack. "daily" crea un archivo por día y borra los viejos.
LOG_STACK=daily

# Canal para avisos de funciones obsoletas. "null" = no guardarlos.
LOG_DEPRECATIONS_CHANNEL=null

# Nivel mínimo que se guarda. En producción "warning" (nunca "debug"): guarda
# fallas reales sin llenar el log de detalles.
LOG_LEVEL=warning

# Cuántos días se conservan los logs diarios.
LOG_DAILY_DAYS=14

# --- Base de datos -----------------------------------------------------------

# Tipo de base de datos. En producción es MySQL (Hostinger), no sqlite.
DB_CONNECTION=mysql

# Servidor y puerto de MySQL. Confirmar en el hPanel de Hostinger.
DB_HOST=127.0.0.1
DB_PORT=3306

# Nombre de la base, usuario y contraseña. Se llenan solo en el servidor.
DB_DATABASE=NOMBRE_BASE_DE_DATOS_AQUI
DB_USERNAME=USUARIO_BASE_DE_DATOS_AQUI
DB_PASSWORD=PASSWORD_BASE_DE_DATOS_AQUI

# --- Sesión y cookies --------------------------------------------------------

# Dónde se guardan las sesiones. "database" usa la tabla "sessions".
SESSION_DRIVER=database

# Minutos de inactividad antes de cerrar la sesión.
SESSION_LIFETIME=120

# Cifra el contenido de la sesión guardada en la base de datos.
SESSION_ENCRYPT=true

# Ruta y dominio de la cookie. "null" = solo el dominio actual.
SESSION_PATH=/
SESSION_DOMAIN=null

# La cookie solo viaja por https. Debe ser "true" en producción.
SESSION_SECURE_COOKIE=true

# JavaScript no puede leer la cookie de sesión.
SESSION_HTTP_ONLY=true

# Protección contra CSRF. Dejar en "lax": con "strict" puede fallar el regreso
# desde el inicio de sesión con Google.
SESSION_SAME_SITE=lax

# --- Archivos, caché y colas -------------------------------------------------

# Disco por defecto para archivos. "local" es privado (no accesible por URL).
# No usar "public" para documentos de ciudadanos.
FILESYSTEM_DISK=local

# Caché. "database" usa la tabla "cache". (Los cambios de caché son de la 6.9.)
CACHE_STORE=database

# Colas de trabajos (recordatorios de pago). "sync" envía al momento y no
# necesita un proceso aparte. Alternativa: "database" más un cron que ejecute
# "php artisan queue:work --stop-when-empty". Pendiente de confirmar con Diego.
QUEUE_CONNECTION=sync

# --- Correo (SMTP de Hostinger) ----------------------------------------------

# En producción "smtp". Con "log" los correos (por ejemplo, el enlace para
# restablecer contraseña) se quedan escritos en el archivo de logs.
MAIL_MAILER=smtp

# Cifrado del correo. "null" con el puerto 587 (STARTTLS).
MAIL_SCHEME=null

# Servidor y puerto SMTP de Hostinger.
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587

# Cuenta y contraseña del correo. La contraseña se llena solo en el servidor.
MAIL_USERNAME=crea@iyemyucatan.com
MAIL_PASSWORD=PASSWORD_CORREO_AQUI

# Remitente que ven los ciudadanos.
MAIL_FROM_ADDRESS="crea@iyemyucatan.com"
MAIL_FROM_NAME="CREA IYEM Yucatán"

# --- Inicio de sesión con Google ---------------------------------------------

# Credenciales de Google Cloud Console. Se llenan solo en el servidor.
GOOGLE_CLIENT_ID=CLIENT_ID_DE_GOOGLE_AQUI
GOOGLE_CLIENT_SECRET=CLIENT_SECRET_DE_GOOGLE_AQUI

# URL de regreso. Debe estar registrada igual en Google Cloud Console:
# https://crea.iyemyucatan.com/auth/google/callback
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# --- Frontend ----------------------------------------------------------------

# Nombre de la aplicación para Vite (se toma de APP_NAME).
VITE_APP_NAME="${APP_NAME}"

# --- Reglas de negocio de CREA -----------------------------------------------

# Año comercial de 360 días.
CREA_DIAS_ANIO=360

# Días de gracia antes de generar mora.
CREA_DIAS_GRACIA=5
